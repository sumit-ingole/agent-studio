{
  "version": 2,
  "name": "adio",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_ENVIRONMENT": "production",
    "NEXT_PUBLIC_APP_URL": "https://adio-agents.vercel.app"
  },
  "cleanUrls": true,
  "trailingSlash": false
}
